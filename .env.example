# Site base URL used by sitemap generation (no trailing slash)
# For production, set on Cloudflare Pages Project settings → Environment variables
SITE_URL=https://meum-diarium.xn--schchner-2za.de

# Optional alternatives recognized by sitemap script:
# VITE_SITE_URL=
# PUBLIC_URL=
# CF_PAGES_URL=

# Firebase configuration — set these in your deployment environment
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
